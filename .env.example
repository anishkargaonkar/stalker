# LLM API Keys (Choose one or multiple)
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GROQ_API_KEY=your_groq_api_key_here  # Free tier available

# Optional: LangSmith for LLM observability
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=stalker-engine

# Email Configuration (Choose one)
# Option 1: SendGrid
SENDGRID_API_KEY=your_sendgrid_api_key_here
FROM_EMAIL=your-email@example.com

# Option 2: SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# Optional: Firecrawl API (for advanced scraping)
FIRECRAWL_API_KEY=your_firecrawl_api_key_here

# Database
DATABASE_URL=sqlite:///./stalker.db

# Redis (optional, for caching)
REDIS_URL=redis://localhost:6379

# Application Settings
APP_ENV=development
DEBUG=True
SECRET_KEY=your-secret-key-here-change-this
API_PORT=8000
UI_PORT=8501